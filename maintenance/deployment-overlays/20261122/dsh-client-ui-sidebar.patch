+/**
+ * Build-time deployment profile of the `feat/sidebar-minimal-nav` branch.
+ *
+ * The deployed NAS artifact is built with `DSH_CLIENT_SIDEBAR_MINIMAL_NAV=true`;
+ * a default build leaves it unset and keeps the upstream full navigation.
+ */
+/**
+ * Panels the minimal deployment keeps out of the functional navigation. These
+ * are stable registration ids, never display labels; the matching `main`
+ * occupants stay registered so scheduled automation and the context/memory
+ * backends keep running and remain reachable through their host services and
+ * the task center. Plugins stays visible because plugin management and the
+ * Creator entry live in the left navigation.
+ */
+const MINIMAL_PANEL_IDS = ['schedules', 'dsh-context'];
+/**
+ * Resolve the deployment policy from the build-time flag.
+ * @param flag - value of `DSH_CLIENT_SIDEBAR_MINIMAL_NAV` fixed when the artifact is built.
+ * @returns policy for the sidebar's functional navigation.
+ */
+export function minimalNavPolicy(flag) {
+    const minimal = flag === 'true';
+    return {
+        hiddenPanelIds: new Set(minimal ? MINIMAL_PANEL_IDS : []),
+        more: !minimal,
+    };
+}
